<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">
  <display-name>spring-boot-style</display-name>

  <!--
    Richer-than-hello fixture. Not a real Spring Boot fat WAR (we don't ship
    one in-tree) but representative in shape: two servlets, a global filter,
    a startup listener, context-params, and a WEB-INF/lib/ placeholder for
    future jar dependencies.
  -->

  <context-param>
    <param-name>app.name</param-name>
    <param-value>spring-boot-style</param-value>
  </context-param>
  <context-param>
    <param-name>app.profile</param-name>
    <param-value>integration-test</param-value>
  </context-param>

  <listener>
    <listener-class>com.example.spring.AppStartupListener</listener-class>
  </listener>

  <filter>
    <filter-name>RequestLoggingFilter</filter-name>
    <filter-class>com.example.spring.RequestLoggingFilter</filter-class>
    <init-param>
      <param-name>prefix</param-name>
      <param-value>[spring-boot-style]</param-value>
    </init-param>
  </filter>
  <filter-mapping>
    <filter-name>RequestLoggingFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <servlet>
    <servlet-name>RootServlet</servlet-name>
    <servlet-class>com.example.spring.RootServlet</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet-mapping>
    <servlet-name>RootServlet</servlet-name>
    <url-pattern>/</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>ApiServlet</servlet-name>
    <servlet-class>com.example.spring.ApiServlet</servlet-class>
    <init-param>
      <param-name>version</param-name>
      <param-value>v1</param-value>
    </init-param>
    <load-on-startup>2</load-on-startup>
  </servlet>
  <servlet-mapping>
    <servlet-name>ApiServlet</servlet-name>
    <url-pattern>/api/*</url-pattern>
  </servlet-mapping>

  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
  </welcome-file-list>
</web-app>
